# ==============================================================================
# Vectrieve - Vertex 2 (Cloudflare R2) Backup Configuration
# ==============================================================================
# 1. Copy this file to .env.backup on the Azure production server (and optionally on your local PC)
# 2. Fill in your R2 API Token credentials below
# ==============================================================================

R2_BUCKET_NAME=vectrieve-backups
AWS_ENDPOINT_URL=https://8eea3ed35f484bc1fdc47cb9a2240bdb.eu.r2.cloudflarestorage.com

# Obtain these from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
# Permissions: Object Read & Write
AWS_ACCESS_KEY_ID=your_r2_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
